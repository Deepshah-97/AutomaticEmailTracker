# Postgres. docker-compose overrides this for the agent container.
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/followup

# Claude (drafting). Model defaults to claude-sonnet-5-5.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Google OAuth: an Internal app in your Workspace with the gmail.readonly and gmail.send scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback
GOOGLE_ALLOWED_DOMAINS=company.com

# Generate with: uv run python -c "from app.core.crypto import generate_key; print(generate_key())"
TOKEN_ENCRYPTION_KEY=
# Long random string. Used for /v1/admin/* only.
ADMIN_API_KEY=

COMPANY_NAME=Company
SENTRY_DSN=

# Run background jobs on exactly one instance.
SCHEDULER_ENABLED=true
# Master switch. Nothing is sent until this is true.
SENDING_ENABLED=false

# Demo isolation: only these addresses can send or receive, and waits are skipped.
TEST_MODE=false
TEST_ALLOWLIST=

SEND_WINDOW_START=08:30
SEND_WINDOW_END=17:30
RANDOM_DELAY_MAX_MINUTES=40
MAX_SENDS_PER_USER_PER_DAY=50
